[gd_resource type="AudioBusLayout" load_steps=4 format=3]

[sub_resource type="AudioEffectHardLimiter" id="limiter"]
pre_gain_db = -2.0
ceiling_db = -0.5

[sub_resource type="AudioEffectReverb" id="canyon_reverb"]
predelay_msec = 90.0
predelay_feedback = 0.35
room_size = 0.85
damping = 0.45
spread = 0.9
hipass = 0.08
dry = 0.0
wet = 0.6

[sub_resource type="AudioEffectLowPassFilter" id="ambient_lp"]
cutoff_hz = 9000.0

[resource]
bus/0/volume_db = 0.0
bus/0/effect/0/effect = SubResource("limiter")
bus/0/effect/0/enabled = true
bus/1/name = &"SFX"
bus/1/solo = false
bus/1/mute = false
bus/1/bypass_fx = false
bus/1/volume_db = 0.0
bus/1/send = &"Master"
bus/2/name = &"Ambient"
bus/2/solo = false
bus/2/mute = false
bus/2/bypass_fx = false
bus/2/volume_db = 0.0
bus/2/send = &"Master"
bus/2/effect/0/effect = SubResource("ambient_lp")
bus/2/effect/0/enabled = true
bus/3/name = &"UI"
bus/3/solo = false
bus/3/mute = false
bus/3/bypass_fx = false
bus/3/volume_db = 0.0
bus/3/send = &"Master"
bus/4/name = &"Canyon"
bus/4/solo = false
bus/4/mute = false
bus/4/bypass_fx = false
bus/4/volume_db = 0.0
bus/4/send = &"SFX"
